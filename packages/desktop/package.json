{
  "name": "@codingpro/desktop",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-preload.mjs && vite build",
    "build:main": "tsc -p tsconfig.json && node scripts/build-preload.mjs",
    "build:renderer": "vite build",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "prepare-pack": "node scripts/prepare-pack.mjs",
    "pack": "node scripts/prepare-pack.mjs && cd .pack && electron-builder --dir",
    "dist": "node scripts/prepare-pack.mjs && cd .pack && electron-builder"
  },
  "dependencies": {
    "@codingpro/core": "workspace:*",
    "@codingpro/llm": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "26.0.12",
    "typescript": "^6.0.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.codingpro.desktop",
    "productName": "CodingPro",
    "electronVersion": "34.2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CodingPro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CodingPro-portable-${version}.${ext}"
    }
  }
}
