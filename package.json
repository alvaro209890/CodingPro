{
  "name": "codingpro-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "build": "pnpm --filter @codingpro/llm build && pnpm --filter @codingpro/core build && pnpm --filter codingpro build && pnpm --filter @codingpro/desktop build && pnpm --filter @codingpro/api build && pnpm --filter @codingpro/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:package",
    "desktop": "pnpm --filter @codingpro/desktop start",
    "desktop:dev": "pnpm --filter @codingpro/desktop dev",
    "desktop:build": "pnpm --filter @codingpro/llm build && pnpm --filter @codingpro/core build && pnpm --filter @codingpro/desktop build",
    "plataforma:build": "pnpm --filter @codingpro/api build && pnpm --filter @codingpro/web build",
    "plataforma:restart": "systemctl --user restart codingpro-api codingpro-web",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "smoke:deepseek": "pnpm build && node scripts/smoke-deepseek.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:evals": "vitest run packages/core/test/hardening-evals.test.ts packages/cli/test/hardening-evals.test.ts",
    "test:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "tsdown": "0.22.13",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
