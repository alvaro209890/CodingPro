{
  "name": "codingpro-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "build": "pnpm --filter codingpro build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:package",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "tsdown": "0.22.13",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
